# CRYSTAL-X Configuration Environment Variables

# Backend Port and Host
API_HOST=0.0.0.0
API_PORT=8000

# Generator Mode (demo or mattergen)
GENERATOR_MODE=demo

# Optional Real Generator (MatterGen) Configuration
MATTERGEN_PATH=
MATTERGEN_CHECKPOINT=
MATTERGEN_MODEL=mattergen_base

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ==========================================
# RAG Scientific Validation & LLM Reasoning
# ==========================================
# If no keys are provided, CRYSTAL-X automatically falls back to its built-in
# offline deterministic scientific reasoning engine and local 139,131-material catalog.
# No paid credentials are required to use the system!

# Optional LLM Providers for Evidence-Grounded Scientific Reports:
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# External Scientific Materials Data Sources:
# 1. Materials Project API (v2) - https://materialsproject.org/api
MP_API_KEY=your_materials_project_api_key_here

# 2. Crystallography Open Database (COD) - https://www.crystallography.net/cod/
# Set to '1' or 'true' to enable live online COD queries (disabled by default for fast offline usage)
ENABLE_COD_API=false
